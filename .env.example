DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_dev_platform?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="please_replace_with_strong_secret"
JWT_EMAIL_VERIFY_SECRET="please_replace_with_email_verify_secret"
PAYMENT_CALLBACK_SECRET="please_replace_with_payment_callback_secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 跨域访问 API 的浏览器 Origin 白名单（逗号分隔）；不填时开发环境默认含 localhost，生产环境依赖 NEXT_PUBLIC_APP_URL
# ALLOWED_ORIGINS="https://boki.help,https://xxx.vercel.app"
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="no-reply@example.com"
SMTP_PASS="please_replace_with_smtp_password"
SMTP_FROM="AI开发者平台 <no-reply@example.com>"
EMAIL_VERIFY_RATE_LIMIT_DISABLED="false"
NODE_ENV="development"
# 生产环境开启模拟充值/模拟托管支付（仅演示自检，真实收款勿开）
# ALLOW_MOCK_PAYMENT=true
# NEXT_PUBLIC_ALLOW_MOCK_PAYMENT=true
# 写入管理员（勿把真实密码提交仓库）
# ADMIN_EMAIL="admin@yourdomain.com"
# ADMIN_PASSWORD="至少8位强密码"
# Vercel 头像上传：项目 → Storage → Create Blob Store → 将 Read/Write Token 填到 Vercel 环境变量
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# 若控制台生成为其它变量名，也可使用：VERCEL_BLOB_READ_WRITE_TOKEN
# 可选：Blob 仅私有 Store 时强制私有上传 + 本站代理出图（跳过首次 public 尝试）
# BLOB_PUT_ACCESS=private
